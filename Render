services:
  - type: web
    name: hisobchi-bot
    env: docker
    plan: free
    dockerfilePath: ./Dockerfile
    envVars:
      - key: BOT_TOKEN
        sync: false
      - key: BOT_USERNAME
        sync: false
      - key: WEBAPP_URL
        sync: false
      - key: DATABASE_URL
        fromDatabase:
          name: hisobchi-db
          property: connectionString
      - key: ADMIN_ID
        sync: false

databases:
  - name: hisobchi-db
    plan: free
